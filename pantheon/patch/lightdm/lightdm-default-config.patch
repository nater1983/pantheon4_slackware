From 34080bcb81a564bcc30c4f3dd20ff52c8d2261e2 Mon Sep 17 00:00:00 2001
From: Nathaniel Russell <46272571+nater1983@users.noreply.github.com>
Date: Mon, 13 Nov 2023 00:05:32 +0000
Subject: [PATCH] Update users.conf

---
 data/lightdm.conf | 4 ++--
 data/users.conf | 4 ++--
 2 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/data/lightdm.conf b/data/lightdm.conf
index 5c0199313..452b9d112 100644
--- a/data/lightdm.conf
+++ b/data/lightdm.conf
@@ -22,7 +22,7 @@
 #start-default-seat=true
 #greeter-user=lightdm
 #minimum-display-number=0
-#minimum-vt=7
+minimum-vt=7
 #lock-memory=true
 #user-authority-in-system-dir=false
 #guest-account-script=guest-account
@@ -36,6 +36,8 @@
 #backup-logs=true
 #dbus-service=true

diff --git a/data/users.conf b/data/users.conf
index 5c0199313..452b9d112 100644
--- a/data/users.conf
+++ b/data/users.conf
@@ -9,6 +9,6 @@
 # hidden-shells = Shells that indicate a user cannot login
 #
 [UserList]
-minimum-uid=500
+minimum-uid=1000
 hidden-users=nobody nobody4 noaccess
-hidden-shells=/bin/false /usr/sbin/nologin /sbin/nologin
+hidden-shells=/bin/false /sbin/nologin
