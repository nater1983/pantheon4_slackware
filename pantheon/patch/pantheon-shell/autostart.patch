From e8fe8c9e7c7510f6a6f1b3d6e7d7f35595262f73 Mon Sep 17 00:00:00 2001
From: Nathaniel Russell <46272571+nater1983@users.noreply.github.com>
Date: Sat, 8 Nov 2025 16:43:31 -0600
Subject: [PATCH 1/5] Create meson.build

---
 plugins/meson.build | 57 +++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 57 insertions(+)
 create mode 100644 plugins/meson.build

diff --git a/plugins/meson.build b/plugins/meson.build
new file mode 100644
index 0000000..12c6c22
--- /dev/null
+++ b/plugins/meson.build
@@ -0,0 +1,57 @@
+# plugins/meson.build
+# Generate GNOME Settings Daemon plugin autostart desktop files for Slackware
+
+# List all GNOME Settings Daemon plugin components
+gsd_plugins = {
+  'A11ySettings':       'a11y-settings',
+  'Color':              'color',
+  'Datetime':           'datetime',
+  'Housekeeping':       'housekeeping',
+  'Keyboard':           'keyboard',
+  'MediaKeys':          'media-keys',
+  'Power':              'power',
+  'PrintNotifications': 'print-notifications',
+  'Rfkill':             'rfkill',
+  'ScreensaverProxy':   'screensaver-proxy',
+  'Sharing':            'sharing',
+  'Smartcard':          'smartcard',
+  'Sound':              'sound',
+  'UsbProtection':      'usb-protection',
+  'Wwan':               'wwan',
+  'XSettings':          'xsettings',
+}
+
+# Install directory for autostart files
+autostart_dir = join_paths(get_option('sysconfdir'), 'xdg', 'autostart')
+
+# For each plugin, generate a .desktop file using configure_file()
+foreach plugin : gsd_plugins
+  desktop_in = 'org.gnome.SettingsDaemon.Real.desktop.in'
+  desktop_out = 'org.gnome.SettingsDaemon.@0@.desktop'.format(plugin)
+
+  # Configure substitutions
+  configure_file(
+    input: desktop_in,
+    output: desktop_out,
+    configuration: {
+      'pluginname': plugin,
+      'description': 'GNOME Settings Daemon {} plugin'.format(plugin),
+      'libexecdir': join_paths(get_option('prefix'), get_option('libexecdir')),
+      # Slackware does not use systemd, so we set this to false
+      'systemd_hidden': 'false',
+    },
+    install: true,
+    install_dir: autostart_dir,
+  )
+endforeach
+
+# Also install a dummy desktop file for completeness
+configure_file(
+  input: 'org.gnome.SettingsDaemon.Dummy.desktop.in',
+  output: 'org.gnome.SettingsDaemon.Dummy.desktop',
+  configuration: {
+    'pluginname': 'dummy',
+  },
+  install: true,
+  install_dir: autostart_dir,
+)

