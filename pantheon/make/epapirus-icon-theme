sed -i -e 's,Papirus-Dark Papirus-Light, ,g' install.sh
THEMES=$(grep \{EXTRA_THEMES install.sh | cut -d= -f2 | cut -d} -f1)

mkdir -p $PKG/usr/share/icons
(
  cd $PKG/usr/share/icons
  for theme in $THEMES; do
    tar xvf $CWD/src/papirus-${MODULAR_PACKAGE_VERSION}.tar.gz --xform "s/papirus-${MODULAR_PACKAGE_VERSION}//" \
      papirus-${MODULAR_PACKAGE_VERSION}/$theme
  done
)
