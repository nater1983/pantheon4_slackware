#!/bin/bash
# /etc/rc.d/rc.4.local
# This file is executed by init(8) when the system enters runlevel 4 (XDM).
#
# Version: 2.01  11/18/25
# Purpose: Start LightDM display manager if available.
# Ensure LightDM user and group exist.

# -------------------------------------------------------------
# Ensure LightDM user and group exist
# -------------------------------------------------------------
if ! grep -q "^lightdm:" /etc/passwd ; then
  echo "Resetting group and user login information for lightdm..."
  /usr/sbin/groupadd -fg 380 lightdm
  /usr/sbin/useradd -c "Light Display Manager" \
    -d /var/lib/lightdm \
    -s /bin/false \
    -u 380 -g 380 -G video lightdm

  chown -R lightdm:lightdm /var/lib/lightdm*
fi

echo "Starting up Lightdm session manager..."
# to use lightdm  by default:
if [ -x /usr/sbin/lightdm ]; then
  exec /usr/sbin/lightdm
fi
